MATCH (country:COUNTRY)<-[:CITY_ISPARTOF_COUNTRY]-(:CITY)<-[:PERSON_ISLOCATEDIN_CITY]-(:PERSON)<-[:FORUM_HASMEMBER_PERSON]-(:FORUM)-[:FORUM_CONTAINEROF_POST]->(:POST)<-[COMMENT_REPLYOF_POST]-(:COMMENT)-[:COMMENT_HASTAG_TAG]->(:TAG)-[:TAG_HASTYPE_TAGCLASS]->(:TAGCLASS) 
RETURN count(country) AS count